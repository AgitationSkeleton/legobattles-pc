{"Network", "Multiplayer", "Port", ""},
{"Network", "Multiplayer", "Use HTTPS with the master server", "Uses an encrypted connection when the server supports it."},
{"Network", "Multiplayer", "Share Match Telemetry", "When you host, sends a match summary (teams, units, map, bans) to the server's Discord log."},
{"Network", "Multiplayer", "Team-Colour Portraits in the Match Picture", "Draws each player's unit icons in that player's team colour in the match summary, by the same rules as Team-Colour Unit Portraits. Off keeps them red."},
{"Network", "Multiplayer", "Fetch a host's mod map I don't have", "Downloads a host's mod map you're missing from the community archive into mods/maps/_archive. Restart the game to use it."},
{"Network", "Multiplayer", "Fast online link", "Keeps online matches at full speed. Every player needs the same setting. Applies the next time you host or join. Off uses the original DS wireless protocol."},
{"Network", "Multiplayer", "Use the save's profile name", "Untick to use a different name online."},
{"Network", "Multiplayer", "Player name", ""},
{"Network", "Multiplayer", "Write this name into the save", "Renames the loaded profile. Saved next time you reach the main menu."},
{"Network", "Multiplayer", "Room code", "Name is how an advertised lobby is listed. Code is what Join by code looks up."},
{"Network", "Multiplayer", "Chat", ""},
{"Network", "Multiplayer", "Chat toasts", "Pops up other players' messages for a few seconds while the chat box is closed."},
{"Network", "Multiplayer", "Swear filter", "Replaces swear words in chat and player names with \"ziff\". Only changes what you see."},
{"Network", "Multiplayer", "Advertise when the game hosts", "Lists your lobby on the master server when you host from the game's menu. It comes off when the match starts or you leave."},
{"Network", "Multiplayer", "Open the port on my router when hosting (UPnP)", "Asks your router to open the game's port while you host. Some routers have UPnP off. Most connections work without it."},
{"Network", "Multiplayer", "Game's Join screen uses the master server", "The game's Join screen shows online lobbies from the master server."},
