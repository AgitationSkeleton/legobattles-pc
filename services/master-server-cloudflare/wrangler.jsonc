// The LEGO Battles master server as a Cloudflare Worker: the lobby directory
// (one Directory Durable Object for everyone) at lbserver.viosarcade.xyz.
// See README.md here for deploying it.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "legobattles-master",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DIRECTORY",
				"class_name": "Directory"
			},
			// docs/424: the relay, one room per lobby (src/relay.js).
			{
				"name": "RELAY",
				"class_name": "RelayRoom"
			},
			// SG-0018: the score tables, one object (src/scores.js).
			{
				"name": "SCORES",
				"class_name": "Scores"
			},
			{
				"name": "LEVELS",
				"class_name": "Levels"
			},
			// docs/501: Discord sign-in accounts (src/auth.js).
			{
				"name": "ACCOUNTS",
				"class_name": "Accounts"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Directory"
			]
		},
		{
			"tag": "relay-v1",
			"new_sqlite_classes": [
				"RelayRoom"
			]
		},
		{
			"tag": "scores-v1",
			"new_sqlite_classes": [
				"Scores"
			]
		},
		{
			"tag": "levels-v1",
			"new_sqlite_classes": [
				"Levels"
			]
		},
		{
			"tag": "accounts-v1",
			"new_sqlite_classes": [
				"Accounts"
			]
		}
	],
	"vars": {
		// An operator ceiling on an advertised max_players, not the game's cap
		// (the Python server's --max-players; see services/master-server).
		"MAX_PLAYERS": "8",
		// docs/442: the fallback server clients turn to when this Worker cannot
		// be reached (services/master-server-fallback, on the operator's PC).
		"FALLBACK_MASTER": "lbfallback.viosarcade.xyz:8787",
		// Approved community levels and units are also posted here, without
		// buttons (src/levels.js, showcase).
		"SHOWCASE_CHANNEL": "1562579248894447756",
		// docs/501: Discord sign-in. The client secret (DISCORD_CLIENT_SECRET)
		// and the signing key (AUTH_SIGNING_KEY) are secrets; LEVELS_CHANNEL
		// (map submissions) is a secret too.
		"DISCORD_CLIENT_ID": "1563424865980252240",
		"AUTH_BASE": "https://lbserver.viosarcade.xyz",
		"UNITS_CHANNEL": "1573499937814216846",
		"ACCOUNTS_CHANNEL": "1573499790715523072",
		// docs/503: every map, unit and account message is mirrored here too
		// (the original submissions channel, in the other server).
		"MIRROR_CHANNEL": "1560706993533091890",
		"MODERATORS": "748343958190555217,436374165747007499,407582656797081612,700097534743543838,692034827196694578,138516660016513024,929465731605758022,629782384081895475,1240026702147616799",
		// The cutover: "1" makes the lobby routes and uploads need a signed-in
		// player on at least MIN_CLIENT_VERSION.
		"REQUIRE_SIGNIN": "1",
		"MIN_CLIENT_VERSION": "0.4.26"
	},
	// viosarcade.xyz is a zone on this Cloudflare account; the address and
	// its certificate are made on the first deploy. Plain HTTP on port 80 is
	// served too, which is what the port's socket client speaks.
	"routes": [
		{
			"pattern": "lbserver.viosarcade.xyz",
			"custom_domain": true
		}
	]
}
